{
  "manifest_version": 3,
  "name": "zero-tabbox",
  "version": "0.1.0",
  "description": "Closes every tab at your daily cutoff. No archive, no undo.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "zero-tabbox",
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },
  "permissions": ["tabs", "alarms", "storage", "notifications"],
  "incognito": "spanning",
  "commands": {
    "end-day-now": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "End day now: close all tabs"
    }
  }
}

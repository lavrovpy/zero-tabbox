{
  "name": "zero-tabbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Closes every tab at your daily cutoff. No archive, no undo.",
  "license": "MIT",
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "build": "bun ./build.mjs --browser=chrome --browser=firefox",
    "build:chrome": "bun ./build.mjs --browser=chrome",
    "build:firefox": "bun ./build.mjs --browser=firefox",
    "watch": "bun ./build.mjs --browser=chrome --browser=firefox --watch",
    "icons": "bun scripts/make-icons.mjs",
    "package": "bun scripts/package.mjs",
    "test": "bun scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "lint:firefox": "addons-linter --warnings-as-errors dist/firefox",
    "verify": "bun run typecheck && bun run test && bun run build && bun run lint:firefox"
  },
  "devDependencies": {
    "@types/bun": "^1.2.10",
    "@types/chrome": "^0.2.6",
    "addons-linter": "^10.10.0",
    "typescript": "^7.0.2",
    "web-ext": "^10.6.0"
  }
}
